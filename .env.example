# =====================================================================
#  blog-component LOCAL DEV PLAYGROUND env (TASK-008 + TASK-011)
# =====================================================================
# Copy this file to `.env` and fill in the two SECRET values below.
# `.env` is gitignored and is read ONLY by the local Vite dev server
# (see dev/server-plugin.ts). This file is dev-only scaffolding and is
# NEVER shipped — package.json `files` ships `dist/` only.
#
# SECURITY MODEL (the whole point of this component):
#   - VITE_-prefixed vars are exposed to the BROWSER bundle. Only put
#     PUBLIC, non-secret config here (projectId + dataset of a public
#     dataset).
#   - The NON-prefixed vars (SANITY_WRITE_TOKEN, ANTHROPIC_API_KEY) are
#     SECRETS. They are loaded server-side via loadEnv() in
#     vite.dev.config.ts and live ONLY in the Node middleware closure.
#     They MUST NOT be referenced from any browser code or via Vite's
#     `define`, or they would leak into the bundle / network tab.

# --- PUBLIC (sent to the browser) ------------------------------------
VITE_SANITY_PROJECT_ID=gvc4yjqj
VITE_SANITY_DATASET=production

# --- SECRET (server-side only; never reaches the browser) ------------
# A Sanity token with Editor/Admin (Administrator) scope — required to
# create/update posts and upload image assets. A Viewer token CANNOT
# write (403 "permission \"create\" required").
SANITY_WRITE_TOKEN=

# An Anthropic API key — used server-side by /api/generate to draft posts.
ANTHROPIC_API_KEY=

# --- DEV-ONLY model override (optional) ------------------------------
# Which Claude model /api/generate uses. The playground DEFAULTS this to the
# cheapest current model (Claude Haiku 4.5) to keep demo costs down. Set it to
# any other model id to override, or set it EMPTY to fall back to the library's
# DEFAULT_AI_MODEL (claude-sonnet-4-6, ~4x the cost of Haiku per generation).
# This does NOT change the library's shipped default — it is dev-only.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
